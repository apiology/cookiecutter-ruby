# shellcheck shell=bash
#
# Cursor / other agents: this is NOT permission to run `op` or `direnv_load` here.
# Ask the user explicitly before any 1Password CLI use in chat.

PATH_add bin

# Solargraph's on-disk pin cache is keyed only on the static Solargraph::VERSION
# string (see upstream lib/solargraph/pin_cache.rb#work_dir), not on the actual
# gem code. When solargraph is pinned to a branch of the apiology/solargraph
# integration fork rather than a released version, a `bundle update` that
# moves the branch to a new commit doesn't bump VERSION -- stale pins from the
# old commit get silently reused. That exact scenario produced a false-positive
# regression report against https://github.com/castwide/solargraph/pull/1274
# (generic<X>/generic<T> leaking into ordinary Hash#fetch calls) that turned out
# to be nothing but this stale cache. Force VERSION to include the pinned git
# revision so any revision change busts the cache. (apiology/solargraph's own
# .envrc does something similar, keyed off branch name; this keys off the exact
# revision instead, since a branch can move to a new commit without a
# corresponding version bump.)

# Print the revision of a `git:` solargraph in Gemfile.lock; fail if none.
locked_solargraph_git_revision() {
  local revision
  revision=$(awk '
    /^GIT$/ { remote = ""; revision = ""; ingit = 1; next }
    ingit && /^  remote:/ { remote = $2 }
    ingit && /^  revision:/ { revision = $2 }
    ingit && /^$/ { if (remote ~ /\/solargraph(\.git)?$/) print revision; ingit = 0 }
  ' Gemfile.lock 2>/dev/null) && [[ -n "${revision}" ]] && echo "${revision}"
}

# Print the directory of a `path:` solargraph in Gemfile.lock; fail if none.
locked_solargraph_path() {
  local checkout
  checkout=$(awk '
    /^PATH$/ { remote = ""; found = 0; inpath = 1; next }
    inpath && /^  remote:/ { remote = $2 }
    inpath && /^    solargraph \(/ { found = 1 }
    inpath && /^$/ { if (found) print remote; inpath = 0 }
  ' Gemfile.lock 2>/dev/null) && [[ -n "${checkout}" ]] && echo "${checkout}"
}

# Run git against a `path:` solargraph checkout. Inside a git hook, git
# exports GIT_DIR, GIT_INDEX_FILE, etc. for this repo, and those override
# `-C`, so without clearing them every call would read this repo instead.
solargraph_git() {
  local checkout="$1"
  shift
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR \
    -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
    -u GIT_IMPLICIT_WORK_TREE -u GIT_PREFIX -u GIT_SHALLOW_FILE \
    -u GIT_GRAFT_FILE -u GIT_NO_REPLACE_OBJECTS -u GIT_REPLACE_REF_BASE \
    git -C "${checkout}" "$@"
}

# Print a SOLARGRAPH_FORCE_VERSION for a `path:` solargraph checkout; fail
# if it is not a git checkout.
#
# solargraph from a local `path:` checkout: its gemspec defaults to the
# released VERSION (e.g. 0.60.3), sharing the global pin-cache namespace
# with every other checkout and the real release, and edits never change
# it. Key the cache on the checkout's code instead: HEAD, plus a hash of
# uncommitted changes (tracked diff and untracked file contents) when the
# tree is dirty, so every edit busts the cache. Identical code yields an
# identical key, which is safe to share.
checkout_dev_version() {
  local checkout="$1" head dirty
  head=$(solargraph_git "${checkout}" rev-parse HEAD 2>/dev/null) || return 1
  dirty=$(
    {
      solargraph_git "${checkout}" diff HEAD --binary
      solargraph_git "${checkout}" ls-files -z --others --exclude-standard \
        | while IFS= read -r -d '' untracked; do
            printf '%s ' "${untracked}"
            solargraph_git "${checkout}" hash-object -- "${untracked}"
          done
    } | solargraph_git "${checkout}" hash-object --stdin
  )
  # git hash-object of empty input: the tree matches HEAD exactly.
  if [[ "${dirty}" == "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391" ]]; then
    echo "0.0.1.dev-${head}"
  else
    echo "0.0.1.dev-${head}.dirty.${dirty:0:12}"
  fi
}

solargraph_version=""
if solargraph_revision=$(locked_solargraph_git_revision); then
  solargraph_version="0.0.1.dev-${solargraph_revision}"
elif solargraph_path=$(locked_solargraph_path); then
  solargraph_version=$(checkout_dev_version "${solargraph_path}")
fi

# Without a git- or path-pinned solargraph, leave both unset.
if [[ -n "${solargraph_version}" ]]; then
  export SOLARGRAPH_FORCE_VERSION="${solargraph_version}"

  # Bundler's git-source checkout for solargraph
  # (<gem home>/bundler/gems/solargraph-<shortsha>/) lives under the
  # shared, machine-wide GEM_HOME by default -- one checkout per revision,
  # shared across every worktree/repo on this machine. Its on-disk
  # gemspec is dynamic (reads SOLARGRAPH_FORCE_VERSION), so any other
  # process resolving the same revision with a different (or absent)
  # value races against this worktree and can leave RubyGems' cached
  # spec for that checkout answering with the wrong version. That
  # produced a `Bundler::GemNotFound`/"can no longer be found in that
  # source" failure, and a silent partial `rbs collection update`
  # result (69 gems -> 25), neither reproducible once Bundler's whole
  # install path is isolated per worktree. Only do this when solargraph
  # is git- or path-pinned -- a released solargraph has no such dynamic
  # gemspec, so there's nothing to isolate and no need to pay a full
  # per-worktree `bundle install` (measured ~1min for checkoff's ~150
  # gems).
  #
  # For a `path:` checkout, keep the bundle in the same per-worktree
  # install path as the git-source case: a worktree bootstrapped while
  # solargraph was git-pinned has its gems only under vendor/bundle, so
  # dropping BUNDLE_PATH on a switch to `path:` fails with
  # Bundler::GemNotFound for every other gem.
  export BUNDLE_PATH="vendor/bundle"
fi

# File probe: bootstrap hooks omit .envrc stderr; see bin/probe_env_local and
# ~/.cache/env-local-probe/<worktree-basename>.log (also .env-local-probe-path).
ENV_LOCAL_PROBE_SOURCE=envrc ENV_LOCAL_PROBE_QUIET=1 ./bin/probe_env_local || true

# -L: worktree symlink to mounted env.local (FIFO; -r is false without a writer).
# -r: regular file or FIFO with an active reader/writer.
if [[ -L config/env.local || -r config/env.local ]]; then
  # Load from mounted Environment file (empty mount => no secrets).
  if grep -qE '^[A-Z][A-Z0-9_]*=.*op://' config/env.local 2>/dev/null; then
    echo "config/env.local must contain resolved values, not op:// references." >&2
    exit 1
  fi
  # Parse KEY=value lines into exports (quoted values unwrapped).
  eval "$(
    ENV_LOCAL_FILE=config/env.local ruby -rshellwords -e '
      File.foreach(ENV.fetch("ENV_LOCAL_FILE")) do |line|
        line = line.strip
        next if line.empty? || line.start_with?("#")
        key, value = line.split("=", 2)
        next if value.nil?
        value = value.strip
        if value.length >= 2 && value.start_with?("\"") && value.end_with?("\"")
          value = value[1..-2]
        end
        puts "export #{Shellwords.escape(key)}=#{Shellwords.escape(value)}"
      end
    '
  )"
elif resolved_env_1p="$(./bin/resolve_env_1p)" && [[ -r "${resolved_env_1p}" ]] && grep -qE '^[A-Z][A-Z0-9_]*=' "${resolved_env_1p}" 2>/dev/null; then
  # Resolve op:// template when env.local is not mounted.
  ENV_1P="${resolved_env_1p}"
  direnv_load op run --cache --env-file="${ENV_1P}" -- direnv dump
fi
